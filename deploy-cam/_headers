/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  # This origin exists to run a camera. Stated explicitly so the intent is
  # visible; both already default to same-origin.
  Permissions-Policy: camera=(self), microphone=(self), geolocation=()

# HTML: always revalidate so app updates go live immediately
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate

# Manifest: correct type + modest cache
/manifest.webmanifest
  Content-Type: application/manifest+json; charset=utf-8
  Cache-Control: public, max-age=86400

# Brand images: cache a day (filenames aren't hashed, so keep it modest)
/icon.svg
  Cache-Control: public, max-age=86400
/icon-192.png
  Cache-Control: public, max-age=86400
/icon-512.png
  Cache-Control: public, max-age=86400
/apple-touch-icon-180.png
  Cache-Control: public, max-age=86400
